# ── Conexión al broker MQTT ───────────────────────────────────────────────────
# IP o hostname de la máquina que corre el backend + broker (máquina principal)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# ── Identidad de este agente edge ─────────────────────────────────────────────
# Cambia estos valores en cada máquina que se conecte a la red
EDGE_ZONE=A          # Letra de la zona (A, B, C, …)
EDGE_RACK=A1         # ID del rack dentro de la zona
NODE_ID=nodo_web_01  # ID único del nodo en este rack

# ── Intervalos de publicación ─────────────────────────────────────────────────
NODE_INTERVAL_S=5    # Cada cuántos segundos se publica telemetría de nodo
ENV_INTERVAL_S=10    # Cada cuántos segundos se publica telemetría ambiental

# ── Reproducibilidad (opcional) ───────────────────────────────────────────────
# Si se define, el RNG de la simulación usará esta semilla (útil para pruebas)
# SIM_SEED=42

# ── Executor ──────────────────────────────────────────────────────────────────
EXECUTOR_ID=executor-A-A1   # ID único del executor (aparece en logs y ACKs)
ACK_DELAY_S=0.5             # Segundos de espera antes de enviar ACK al backend
